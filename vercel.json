{
  "services": {
    "web": {
      "root": "apps/web",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "server": {
      "root": "apps/server",
      "entrypoint": "entry.mjs",
      "bindings": [
        {
          "type": "service",
          "service": "jev",
          "format": "url",
          "env": "JEV_SERVICE_URL"
        }
      ]
    },
    "jev": {
      "root": "apps/jev",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/rpc/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
