# Storage. Local dev defaults to a SQLite file if unset.
# In production, point this at managed Postgres (Neon) — a postgres:// URL.
# DATABASE_URL=postgresql://user:pass@host/db

# Scoring. Without a key the worker uses the heuristic FakeClient.
# TYPESAFE_API_KEY=apikey_...

# Ingestion at scale (GitHub code search). Required only for `ingest-github`.
# GITHUB_TOKEN=ghp_...
